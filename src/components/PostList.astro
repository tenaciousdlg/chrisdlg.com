---
import type { CollectionEntry } from 'astro:content';

interface Props {
  posts: CollectionEntry<'blog'>[];
}
const { posts } = Astro.props;
---

<ul class="post-list" role="list">
  {posts.map((post) => (
    <li class="post-item box">
      <div class="post-meta">
        <time class="dim" datetime={post.data.date.toISOString()}>
          {post.data.date.toISOString().slice(0, 10)}
        </time>
        {post.data.tags.length > 0 && (
          <span class="tags">
            {post.data.tags.map((t: string) => (
              <a class="tag" href={`/blog/tags/${t}/`}>{t}</a>
            ))}
          </span>
        )}
      </div>
      <h2 class="post-title">
        {post.data.external ? (
          <a href={post.data.external} target="_blank" rel="noopener">{post.data.title} <span class="ext-mark">↗</span></a>
        ) : (
          <a href={`/blog/${post.id}/`}>{post.data.title}</a>
        )}
      </h2>
      <p class="post-desc">{post.data.description}</p>
      {post.data.external ? (
        <a href={post.data.external} target="_blank" rel="noopener" class="read-more">read at {new URL(post.data.external).hostname} &gt;</a>
      ) : (
        <a href={`/blog/${post.id}/`} class="read-more">read more &gt;</a>
      )}
    </li>
  ))}
</ul>

<style>
  .post-list { list-style: none; padding: 0; }
  .post-item { padding: 1.25rem !important; }
  .post-meta { display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; margin-bottom: 0.4rem; font-size: 0.85rem; }
  .post-title { font-size: 1.4rem; margin-bottom: 0.4rem; }
  .post-title a { color: var(--green-bright); }
  .post-title a:hover { text-shadow: var(--glow-strong); }
  .post-desc { color: var(--white); margin-bottom: 0.6rem; font-size: 0.92rem; }
  .read-more { font-size: 0.85rem; }
  .ext-mark { color: var(--amber); font-size: 0.8em; }
  a.tag { text-decoration: none; }
  a.tag:hover { color: var(--green-bright); border-color: var(--green-bright); }
</style>
