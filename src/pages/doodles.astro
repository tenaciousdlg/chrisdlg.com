---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';

// Build-time optimization (sharp): originals live in src/assets/doodles and
// ship as responsive AVIF/WebP at gallery width — the raw files were ~10MB
// of PNG/JPG for a two-column grid.
import logo from '../assets/doodles/logo.png';
import youAndI from '../assets/doodles/you_and_i.jpg';
import threeAmigos from '../assets/doodles/three_amigos.png';
import helloWhale from '../assets/doodles/hello_whale.png';
import floating from '../assets/doodles/floating.png';
import ah1 from '../assets/doodles/ah_1.png';
import ah2 from '../assets/doodles/ah_2.png';
import hi from '../assets/doodles/hi.png';
import smile from '../assets/doodles/smile.png';
import selfDrawing from '../assets/doodles/self_drawing.png';
import archie1 from '../assets/doodles/archie_1.jpg';
import pomeranian from '../assets/doodles/pomeranian.jpeg';
import scribble from '../assets/doodles/scribble.png';
import signature from '../assets/doodles/signature.png';

const pieces = [
  { src: logo,        title: 'Logo' },
  { src: youAndI,     title: 'You & I' },
  { src: threeAmigos, title: 'Three Amigos' },
  { src: helloWhale,  title: 'Hello Whale' },
  { src: floating,    title: 'Float' },
  { src: ah1,         title: 'AH!' },
  { src: ah2,         title: 'AH! (sketch)' },
  { src: hi,          title: 'Hi' },
  { src: smile,       title: 'Smile' },
  { src: selfDrawing, title: 'Self Portrait' },
  { src: archie1,     title: 'Archie' },
  { src: pomeranian,  title: 'Pomeranian' },
  { src: scribble,    title: 'Scribble' },
  { src: signature,   title: 'Signature' },
];
---

<BaseLayout title="Sketchbook" description="iPad doodles by Chris De La Garza — creatures, portraits, and whatever else happens on long flights.">
  <h1 class="glitch page-title">// SKETCHBOOK</h1>
  <p class="intro dim">iPad doodles. Mostly on flights.</p>

  <div class="gallery" id="gallery">
    {pieces.map(p => (
      <figure class="piece">
        <div class="piece-img-wrap">
          <Image
            src={p.src}
            alt={p.title}
            widths={[400, 700]}
            sizes="(max-width: 680px) 95vw, 45vw"
            format="avif"
            quality="mid"
            loading="lazy"
            draggable="false"
          />
          <div class="piece-shield" aria-hidden="true"></div>
        </div>
        <figcaption>{p.title}</figcaption>
      </figure>
    ))}
  </div>
</BaseLayout>

<style>
  .page-title { font-size: 2rem; margin-bottom: 0.5rem; }
  .intro { margin-bottom: 2rem; font-size: 0.9rem; }

  .gallery {
    columns: 2 320px;
    column-gap: 1rem;
  }

  .piece {
    break-inside: avoid;
    margin: 0 0 1rem;
    border: 1px solid var(--border);
    background: var(--bg-2);
    transition: border-color 0.2s;
  }

  .piece:hover {
    border-color: var(--amber);
  }

  .piece-img-wrap {
    position: relative;
    line-height: 0;
  }

  .piece img {
    width: 100%;
    height: auto;
    display: block;
    user-select: none;
    -webkit-user-drag: none;
  }

  .piece-shield {
    position: absolute;
    inset: 0;
    z-index: 1;
    cursor: default;
  }

  figcaption {
    font-family: var(--font-pixel);
    font-size: 0.85rem;
    color: var(--text-dim);
    padding: 0.4rem 0.6rem;
    border-top: 1px solid var(--border);
    letter-spacing: 0.06em;
  }
</style>

<script>
  document.getElementById('gallery')?.addEventListener('contextmenu', e => e.preventDefault());
</script>
